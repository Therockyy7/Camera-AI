{
  "CameraAI": {
    "TimeZone": "Asia/Ho_Chi_Minh",
    "ModelsDir": "../../../models",
    "Camera": {
      "Source": "0",
      "Id": "laptop",
      "Width": 1280,
      "Height": 720
    },
    "Processing": {
      "Fps": 8,
      "DetectWidth": 640
    },
    "Recognition": {
      "Model": "sface",
      "SfaceThreshold": 0.363,
      "ArcfaceThreshold": 0.30,
      "DetectScore": 0.8,
      "MinFacePx": 40,
      "MinSharpness": 12,
      "MaxTurn": 0.45
    },
    "Liveness": {
      "Mode": "Opportunistic",
      "Threshold": 0.5,
      "SpoofThreshold": 0.3,
      "MinFacePx": 64,
      "MaxTurn": 0.25
    },
    "Attendance": {
      "WindowFrames": 5,
      "ConfirmFrames": 3,
      "CooldownMinutes": 5
    },
    "Enrollment": {
      "SamplesPerCapture": 8,
      "CaptureTimeoutSeconds": 15,
      "MinFacePx": 80,
      "MinDetScore": 0.9,
      "MaxSimilarity": 0.92
    },
    "Storage": {
      "DataDir": "../../../data",
      "SnapshotRetentionDays": 30
    },
    "Web": {
      "Host": "127.0.0.1",
      "Port": 8000,
      "AdminPassword": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AllowedHosts": "*"
}
